{
  "name": "fan",
  "productName": "Fan",
  "private": true,
  "version": "0.4.3",
  "description": "Native desktop shell for Fan Agent.",
  "homepage": "https://fandcode.com",
  "author": "Xingfan Technology",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ../../scripts/dev.mjs",
    "dev:app": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:fake-boot": "cross-env FAN_DESKTOP_BOOT_FAKE=1 FAN_DESKTOP_BOOT_FAKE_STEP_MS=650 npm run dev",
    "dev:renderer": "node scripts/assert-root-install.cjs && vite --host 127.0.0.1 --port 5174",
    "dev:electron": "wait-on http://127.0.0.1:5174 && cross-env XCURSOR_SIZE=24 FAN_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "profile:main": "wait-on http://127.0.0.1:5174 && cross-env XCURSOR_SIZE=24 FAN_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron --inspect=9229 .",
    "profile:main:cpu": "wait-on http://127.0.0.1:5174 && cross-env XCURSOR_SIZE=24 NODE_OPTIONS=--cpu-prof FAN_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "start": "npm run build && electron .",
    "build": "node scripts/assert-root-install.cjs && node scripts/write-build-stamp.cjs && node scripts/stage-native-deps.cjs && tsc -b && vite build",
    "build:bundled-backend": "node scripts/build-python-backend.mjs",
    "builder": "cross-env NODE_OPTIONS=--max-old-space-size=16384 node scripts/run-electron-builder.cjs",
    "package:prepare": "npm run build:bundled-backend && npm run build",
    "pack": "npm run package:prepare && npm run builder -- --dir",
    "dist": "npm run package:prepare && npm run builder",
    "dist:mac": "npm run package:prepare && npm run builder -- --mac",
    "dist:mac:dmg": "npm run package:prepare && npm run builder -- --mac dmg",
    "dist:mac:zip": "npm run package:prepare && npm run builder -- --mac zip",
    "dist:win": "npm run package:prepare && npm run builder -- --win",
    "dist:win:msi": "npm run package:prepare && npm run builder -- --win msi",
    "dist:win:nsis": "npm run package:prepare && npm run builder -- --win nsis",
    "dist:linux": "npm run package:prepare && npm run builder -- --linux AppImage deb rpm",
    "dist:linux:docker": "bash scripts/build-linux-arm64-docker.sh",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop:all": "node scripts/test-desktop.mjs all",
    "test:desktop:dmg": "node scripts/test-desktop.mjs dmg",
    "test:desktop:nsis": "node scripts/test-desktop.mjs nsis",
    "test:desktop:existing": "node scripts/test-desktop.mjs existing",
    "test:desktop:fresh": "node scripts/test-desktop.mjs fresh",
    "type-check": "tsc -b",
    "lint": "eslint src/ electron/",
    "lint:fix": "eslint src/ electron/ --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'electron/**/*.{js,cjs}' 'vite.config.ts'",
    "fix": "npm run lint:fix && npm run fmt",
    "preview": "node scripts/assert-root-install.cjs && vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-streamdown": "^0.3.5",
    "@fan/shared": "file:../shared",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource/poppins": "^5.2.7",
    "@nanostores/react": "^1.1.0",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "ignore": "^7.0.5",
    "katex": "^0.16.45",
    "leva": "^0.10.1",
    "lucide-react": "^0.577.0",
    "nanostores": "^1.3.0",
    "node-pty": "1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-arborist": "^3.5.0",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "react-shiki": "^0.9.3",
    "remark-math": "^6.0.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-shimmer": "^0.4.11",
    "unicode-animations": "^1.0.3",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@eslint/js": "^9.39.4",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.9",
    "eslint": "9.39.5",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "electronVersion": "43.2.0",
    "appId": "com.xingfan.fan",
    "productName": "Fan",
    "executableName": "Fan",
    "protocols": [
      {
        "name": "Fan",
        "schemes": [
          "fan"
        ]
      }
    ],
    "artifactName": "Fan-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "7757",
        "repo": "Fan-Browser-Agent",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "assets/fanTemplate.png",
      "assets/fanTemplate@2x.png",
      "assets/icon.ico",
      "assets/icon.png",
      "electron/**",
      "!electron/**/{test,tests,__tests__}/**",
      "!electron/**/*.{test,spec}.{js,cjs,mjs,ts,tsx,jsx}",
      "!**/*.log",
      "package.json"
    ],
    "beforeBuild": "scripts/before-build.cjs",
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/install-stamp.json",
        "to": "install-stamp.json"
      },
      {
        "from": "build/native-deps",
        "to": "native-deps"
      },
      {
        "from": "build/python",
        "to": "python"
      },
      {
        "from": "build/fan-src",
        "to": "fan-src"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**",
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "electronLanguages": [
        "af",
        "de",
        "en",
        "en_GB",
        "es",
        "es_419",
        "fr",
        "hu",
        "it",
        "ja",
        "ko",
        "pt_BR",
        "pt_PT",
        "ru",
        "tr",
        "uk",
        "zh_CN",
        "zh_TW"
      ],
      "extendInfo": {
        "CFBundleDisplayName": "Fan",
        "CFBundleExecutable": "Fan",
        "CFBundleName": "Fan",
        "NSAudioCaptureUsageDescription": "Fan uses audio capture for voice conversations.",
        "NSMicrophoneUsageDescription": "Fan uses the microphone for voice input and voice conversations."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Install Fan",
      "backgroundColor": "#f5f5f7",
      "iconSize": 96,
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 160,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "legalTrademarks": "Fan",
      "electronLanguages": [
        "af",
        "de",
        "en-US",
        "en-GB",
        "es",
        "es-419",
        "fr",
        "hu",
        "it",
        "ja",
        "ko",
        "pt-BR",
        "pt-PT",
        "ru",
        "tr",
        "uk",
        "zh-CN",
        "zh-TW"
      ],
      "target": [
        "nsis",
        "msi"
      ]
    },
    "linux": {
      "category": "Development",
      "electronLanguages": [
        "af",
        "de",
        "en-US",
        "en-GB",
        "es",
        "es-419",
        "fr",
        "hu",
        "it",
        "ja",
        "ko",
        "pt-BR",
        "pt-PT",
        "ru",
        "tr",
        "uk",
        "zh-CN",
        "zh-TW"
      ],
      "maintainer": "Xingfan Technology <support@xingfan.com>",
      "synopsis": "Native desktop shell for Fan Agent.",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Fan",
      "uninstallDisplayName": "Fan",
      "warningsAsErrors": false
    }
  }
}
